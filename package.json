{
  "name": "02---wheather",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "scripts": {
    "dev": "bun run src/index.ts --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "bunx tsc --noEmit",
    "prebuild": "bun test",
    "build": "bun test && bunx tsc --noEmit && bun build --compile src/index.ts --outfile weather-cli",
    "start": "bun run src/index.ts"
  }
}
